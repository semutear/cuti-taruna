# Template konfigurasi untuk deployment PRODUKSI (branch secure).
# SR-09: aplikasi produksi WAJIB APP_DEBUG=false agar tidak membocorkan
# stack trace / detail error ke pengguna. Salin nilai relevan ke .env
# server produksi (jangan commit .env asli).

APP_NAME="Sistem Cuti Taruna"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ganti-dengan-domain-produksi

LOG_LEVEL=error

# Gunakan MySQL/PostgreSQL untuk produksi (SQLite hanya untuk dev/demo)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cuti_taruna
DB_USERNAME=
DB_PASSWORD=

# SR-11: admin login butuh username + password.
# Set salah satu (bukan hardcode di seeder) sebelum php artisan db:seed.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
